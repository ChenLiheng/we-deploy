# =====================================================
# WeDeploy 环境变量示例
# =====================================================

# ---- 前端 (Vite) ----
# 后端 API 地址（开发环境通常是 http://localhost:8080/api）
VITE_API_BASE_URL=http://localhost:8080/api

# ---- 后端 (Node.js) ----
# 【生产必填】JWT 签名密钥，可用 `openssl rand -hex 32` 生成
JWT_SECRET=
# 【生产必填】Git Token / 微信 CI 私钥的加密密钥；设置后不要修改，否则已保存的密钥无法解密
APP_ENCRYPTION_KEY=
# 初始管理员（仅在数据库没有任何用户时生效；不设密码则随机生成并打印到启动日志）
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=
# 全局最大并发构建数（优先级高于「系统设置」页面中的配置）
# MAX_CONCURRENT_BUILDS=2
# 监听端口（默认 8080）
PORT=8080
# 监听地址（默认 0.0.0.0；本地开发可用 127.0.0.1）
HOST=0.0.0.0
# SQLite 数据库文件路径（默认 server/data/we-deploy.db）
# DB_PATH=/var/lib/we-deploy/we-deploy.db
# 构建记录与日志保留天数（早于该时间的 builds + build_logs 会被清理；默认 30；设为 0 关闭）
# LOG_RETENTION_DAYS=30
# 沙盒目录：构建任务 git clone 出来的临时代码
# SANDBOX_BASE=/var/lib/we-deploy/sandbox
# 预览二维码图片保存目录
# QRCODE_BASE=/var/lib/we-deploy/qrcodes
# miniprogram-ci 执行时 process.cwd() 落点（避免在 server/ 项目目录写 MD5 临时目录；默认 /tmp/we-deploy/ci-proc）
# CI_PROC_CWD=/tmp/we-deploy/ci-proc

# ---- Docker Compose ----
# Web 容器对外暴露的端口（默认 8000）
WE_DEPLOY_PORT=8000
